    "test:ui-gates": "node --import tsx --test src/change-intent.test.ts src/ui-gates.fixture.test.ts"
  },
  "dependencies": {
    "@slopcontrol/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
