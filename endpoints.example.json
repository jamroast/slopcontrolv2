{
  "endpoints": [
    {
      "id": "ollama-cloud-kimi",
      "label": "Ollama Cloud Kimi K3 (multimodal; Extra Usage — use sparingly)",
      "baseUrl": "https://ollama.com/v1",
      "apiKey": "${OLLAMA_API_KEY}",
      "apiType": "openai-chat",
      "modelId": "kimi-k3:cloud",
      "capabilities": { "chat": true, "vision": true, "imageGen": false }
    },
    {
      "id": "ollama-cloud-glm",
      "label": "Ollama Cloud GLM 5.2 (text only — no vision)",
      "baseUrl": "https://ollama.com/v1",
      "apiKey": "${OLLAMA_API_KEY}",
      "apiType": "openai-chat",
      "modelId": "glm-5.2:cloud",
      "capabilities": { "chat": true, "vision": false, "imageGen": false }
    },
    {
      "id": "ollama-cloud-deepseek",
      "label": "Ollama Cloud DeepSeek V4 Pro (text — design-loop / fast chat)",
      "baseUrl": "https://ollama.com/v1",
      "apiKey": "${OLLAMA_API_KEY}",
      "apiType": "openai-chat",
      "modelId": "deepseek-v4-pro:cloud",
      "capabilities": { "chat": true, "vision": false, "imageGen": false }
    },
    {
      "id": "ollama-kimi-vision",
      "label": "Ollama kimi-k2.7-code (vision chat)",
      "baseUrl": "https://ollama.com/v1",
      "apiKey": "${OLLAMA_API_KEY}",
      "apiType": "openai-chat",
      "modelId": "kimi-k2.7-code:cloud",
      "capabilities": { "chat": true, "vision": true, "imageGen": false }
    },
    {
      "id": "ollama-image",
      "label": "Ollama image generation (Flux Klein — recommended on 16GB; alt: x/z-image-turbo)",
      "baseUrl": "http://localhost:11434/v1",
      "apiType": "openai-images",
      "modelId": "x/flux2-klein",
      "capabilities": { "chat": false, "vision": false, "imageGen": true }
    },
    {
      "id": "local-ollama-cloud",
      "label": "Local Ollama daemon routing to cloud (ollama signin; no API key)",
      "baseUrl": "http://localhost:11434/v1",
      "apiType": "openai-chat",
      "modelId": "glm-5.2:cloud",
      "capabilities": { "chat": true, "vision": false, "imageGen": false }
    },
    {
      "id": "local-coder",
      "label": "Local Qwen Coder",
      "baseUrl": "http://localhost:11434/v1",
      "apiType": "openai-chat",
      "modelId": "qwen2.5-coder",
      "capabilities": { "chat": true, "vision": false, "imageGen": false }
    }
  ],
  "roles": {
    "research": { "endpointId": "ollama-cloud-deepseek" },
    "planning": { "endpointId": "ollama-cloud-deepseek" },
    "supervisor": { "endpointId": "ollama-cloud-deepseek" },
    "coding": { "endpointId": "ollama-cloud-deepseek" },
    "design": { "endpointId": "ollama-cloud-deepseek" },
    "classification": { "endpointId": "ollama-cloud-glm" },
    "designVision": { "endpointId": "ollama-kimi-vision" },
    "designImage": { "endpointId": "ollama-image" }
  }
}
