# Required for Ollama Cloud (https://ollama.com/v1) endpoints.
# Referenced from ~/.slopcontrol/endpoints.json as ${OLLAMA_API_KEY}.
OLLAMA_API_KEY=

# Optional — leave unset (or delete) to use ~/.slopcontrol
# SLOPCONTROL_DATA_DIR=

SLOPCONTROL_PORT=3020
OPENCODE_PORT=4096

# Optional coding-turn timeouts (ms). Defaults: turn 240000, idle 90000.
# SLOPCONTROL_CODING_TURN_MS=240000
# SLOPCONTROL_CODING_IDLE_MS=90000

# Optional Obsidian vault sync
# OBSIDIAN_VAULT_PATH=
