# Provider API keys should go in ~/.slopcontrol/providers.json
# (managed via MCP provider_set or PUT /config/providers/:name).
# The vars below are kept for backward compatibility with endpoints.json
# that still uses ${VAR} substitution.

# Required for Ollama Cloud (https://ollama.com/v1) endpoints.
# Referenced from ~/.slopcontrol/endpoints.json as ${OLLAMA_API_KEY}.
OLLAMA_API_KEY=

# Example: OpenRouter (https://openrouter.ai/api/v1)
# Add to providers.json instead: provider_set name=openrouter apiKey=sk-or-v1-...
# OPENROUTER_API_KEY=

# Optional — leave unset (or delete) to use ~/.slopcontrol
# SLOPCONTROL_DATA_DIR=

SLOPCONTROL_PORT=3020
OPENCODE_PORT=4096

# Optional coding-turn timeouts (ms). Defaults: turn 240000, idle 90000.
# SLOPCONTROL_CODING_TURN_MS=240000
# SLOPCONTROL_CODING_IDLE_MS=90000

# Optional develop-loop retry budget (default 8 identical no-progress iterations).
# SLOPCONTROL_MAX_NO_PROGRESS=4

# Optional Obsidian vault sync
# OBSIDIAN_VAULT_PATH=
